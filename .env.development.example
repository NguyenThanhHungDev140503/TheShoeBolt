# Development Environment Configuration
# Copy this file to .env.development and update with your development values

# Application Settings
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=dev_user
DB_PASSWORD=dev_password
DB_NAME=theshoebolt_dev

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password

# Elasticsearch Configuration
ES_NODE=http://elasticsearch:9200

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb_user:mongodb_password@mongodb:27017/theshoebolt_dev
MONGODB_USERNAME=mongodb_user
MONGODB_PASSWORD=dev_mongodb_password

# RabbitMQ Configuration
RABBITMQ_USER=dev_rabbitmq
RABBITMQ_PASSWORD=dev_rabbitmq_password

# JWT Configuration (Legacy - for backward compatibility)
JWT_SECRET=dev_jwt_secret_at_least_32_characters_long

# Clerk Authentication (Development Keys)
CLERK_SECRET_KEY=sk_test_your_development_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_development_clerk_publishable_key
CLERK_JWT_ISSUER=https://your-dev-clerk-issuer
CLERK_WEBHOOK_SECRET=whsec_your_development_webhook_secret

# Stripe Configuration (Development Keys)
STRIPE_SECRET_KEY=sk_test_your_development_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_development_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_development_stripe_webhook_secret

# Email Service Configuration (Development SMTP)
EMAIL_HOST=smtp.devprovider.local
EMAIL_PORT=1025
EMAIL_AUTH_USER=dev@local.test
EMAIL_AUTH_PASSWORD=dev_email_password
EMAIL_FROM=dev@local.test

# Resend Configuration (Alternative to SMTP)
RESEND_API_KEY=re_your_development_resend_api_key

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=/var/log/theshoebolt/dev-app.log

# Security Configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=200
HELMET_CSP_DIRECTIVES=default-src 'self' 'unsafe-inline' http://localhost:3000

# Performance Configuration
MAX_FILE_SIZE=20mb
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000

# Database Connection Pool
DB_CONNECTION_POOL_MIN=1
DB_CONNECTION_POOL_MAX=5
DB_CONNECTION_TIMEOUT=60000

# Cache Configuration
CACHE_TTL=600
CACHE_MAX_ITEMS=500

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true

